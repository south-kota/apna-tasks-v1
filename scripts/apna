#!/usr/bin/env bash
# apna — daily-driver helper for the Apna Tasks app.
#
#   apna dev up       start the local web dev stack (detached), open a browser tab
#   apna dev down     stop it
#   apna dev restart  stop + start (after server-side changes; web edits hot-reload)
#   apna dev status   is it running? which ports/URL?
#   apna dev logs     tail the dev log
#   apna dev pair     mint a fresh one-time pairing URL if the browser lost auth
#
#   apna app update   rebuild the DMG from the working tree and reinstall into /Applications
#   apna app run      launch the installed app (builds + installs first if missing)
#   apna app quit     quit the running app
#   apna app build    build the DMG only, no install
#   apna app install  install the last built DMG without rebuilding
#
# Dev state lives in the repo-local .apnatasks directory (gitignored), never
# the shared ~/.apnatasks home. Installed builds are unsigned local builds
# (Tier 1): "update" is rebuild-and-reinstall by design; no auto-updater.
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  RESOLVED="$(readlink -f "$SCRIPT_PATH" 2>/dev/null || true)"
  [ -n "$RESOLVED" ] && SCRIPT_PATH="$RESOLVED"
fi
REPO_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
RELEASE_DIR="$REPO_ROOT/release"

find_built_zip() {
  # Newest mac zip in release/ (the .app payload; the DMG is for manual installs)
  ls -t "$RELEASE_DIR"/*-arm64.zip 2>/dev/null | head -1
}

extract_built_app() {
  # Unpacks the newest zip and prints the path of the .app inside it
  local built_zip="$1"
  local extract_dir="$RELEASE_DIR/.apna-extract"
  rm -rf "$extract_dir"
  mkdir -p "$extract_dir"
  ditto -xk "$built_zip" "$extract_dir" >&2
  find "$extract_dir" -maxdepth 1 -name "*.app" -type d | head -1
}

build() {
  echo "==> Building DMG (unsigned, arm64) from $REPO_ROOT"
  (cd "$REPO_ROOT" && pnpm dist:desktop:dmg:arm64)
}

install_app() {
  local built_zip built_app
  built_zip="$(find_built_zip)"
  if [ -z "$built_zip" ]; then
    echo "error: no mac zip found under $RELEASE_DIR — build failed?" >&2
    exit 1
  fi
  built_app="$(extract_built_app "$built_zip")"
  if [ -z "$built_app" ]; then
    echo "error: no .app inside $built_zip" >&2
    exit 1
  fi
  local app_name dest
  app_name="$(basename "$built_app" .app)"
  dest="/Applications/$(basename "$built_app")"

  quit_app "$app_name" "$dest"

  echo "==> Installing to $dest"
  rm -rf "$dest"
  ditto "$built_app" "$dest"
  rm -rf "$RELEASE_DIR/.apna-extract"
  xattr -dr com.apple.quarantine "$dest" 2>/dev/null || true
  echo "==> Installed $(basename "$dest")"
}

installed_app() {
  find /Applications -maxdepth 1 -name "Apna Tasks*.app" -type d 2>/dev/null | head -1
}

quit_app() {
  local app_name="$1" app_path="$2"
  # pgrep -f patterns are regexes; swap parens (as in "(Alpha)") for '.' wildcards
  local match="${app_path//[()]/.}/Contents/MacOS"
  if ! pgrep -f "$match" >/dev/null 2>&1; then
    return 0
  fi
  echo "==> Quitting running instance of $app_name"
  osascript -e "tell application \"$app_name\" to quit" 2>/dev/null || true
  for _ in $(seq 1 20); do
    pgrep -f "$match" >/dev/null 2>&1 || break
    sleep 0.5
  done
  pgrep -f "$match" >/dev/null 2>&1 && pkill -f "$match" || true
  sleep 1
}

quit_installed() {
  local dest
  dest="$(installed_app)"
  if [ -z "$dest" ]; then
    echo "no installed app found" >&2
    exit 1
  fi
  quit_app "$(basename "$dest" .app)" "$dest"
  echo "==> Quit $(basename "$dest")"
}

launch() {
  local dest
  dest="$(installed_app)"
  if [ -z "$dest" ]; then
    echo "==> No installed app found; building first"
    build
    install_app
    dest="$(installed_app)"
  fi
  echo "==> Launching $(basename "$dest")"
  open "$dest"
}

# ---------------------------------------------------------------------------
# dev: detached local web dev stack with repo-local isolated state
# ---------------------------------------------------------------------------

DEV_STATE_DIR="$REPO_ROOT/.apnatasks"
DEV_LOG_FILE="$DEV_STATE_DIR/dev.log"
DEV_PID_FILE="$DEV_STATE_DIR/dev.pid"

# A live pid alone is not proof: after a crash or reboot the OS can hand the
# recorded pid to an unrelated process (even a shell), and killing that group
# closes the user's terminal. Only trust a pid whose command is our dev runner.
dev_running_pid() {
  [ -f "$DEV_PID_FILE" ] || return 1
  local pid command
  pid="$(cat "$DEV_PID_FILE")"
  [ -n "$pid" ] || return 1
  command="$(ps -o command= -p "$pid" 2>/dev/null)" || return 1
  case "$command" in
    *dev-runner.ts*) printf '%s' "$pid" ;;
    *) return 1 ;;
  esac
}

# Ports can shift when occupied, so always read them from the latest
# "[dev-runner] mode=... serverPort=... webPort=..." line in the log.
dev_runner_field() {
  grep -F '[dev-runner] mode=' "$DEV_LOG_FILE" 2>/dev/null | tail -1 |
    sed -n "s/.*$1=\([^ ]*\).*/\1/p"
}

dev_web_url() {
  local port
  port="$(dev_runner_field webPort)"
  [ -n "$port" ] && printf 'http://localhost:%s' "$port"
}

dev_up() {
  local pid url
  if pid="$(dev_running_pid)"; then
    echo "Already running (pid $pid) — $(dev_web_url)"
    return 0
  fi
  mkdir -p "$DEV_STATE_DIR"
  : > "$DEV_LOG_FILE"
  (
    cd "$REPO_ROOT"
    # Job control gives the background job its own process group, so a later
    # group-kill can only ever reach the dev runner and its children.
    set -m
    nohup node scripts/dev-runner.ts dev \
      --home-dir "$DEV_STATE_DIR" --browser >> "$DEV_LOG_FILE" 2>&1 &
    echo "$!" > "$DEV_PID_FILE"
  )

  echo "==> Starting dev stack (log: $DEV_LOG_FILE)"
  for _ in $(seq 1 60); do
    url="$(dev_web_url || true)"
    if [ -n "$url" ]; then
      echo "==> Up: $url  (server port $(dev_runner_field serverPort), pid $(cat "$DEV_PID_FILE"))"
      echo "    A browser tab should open on its own; if it asks to pair, run: apna dev pair"
      return 0
    fi
    if ! dev_running_pid >/dev/null; then
      echo "error: dev runner exited during startup — last log lines:" >&2
      tail -20 "$DEV_LOG_FILE" >&2
      exit 1
    fi
    sleep 1
  done
  echo "error: timed out waiting for dev-runner to report ports; check: apna dev logs" >&2
  exit 1
}

dev_down() {
  local pid pgid
  if ! pid="$(dev_running_pid)"; then
    echo "Not running."
    rm -f "$DEV_PID_FILE"
    return 0
  fi
  # Kill the whole process group so vite + server children go down together —
  # but only when the runner leads its own group (dev_up guarantees this via
  # set -m). A pid inside someone else's group gets a plain single-pid kill;
  # group-killing it could take the user's shell down with it.
  pgid="$(ps -o pgid= -p "$pid" | tr -d ' ')"
  if [ -n "$pgid" ] && [ "$pgid" = "$pid" ]; then
    kill -TERM -- "-$pgid" 2>/dev/null || true
  else
    pgid=""
    kill -TERM "$pid" 2>/dev/null || true
  fi
  for _ in $(seq 1 10); do
    dev_running_pid >/dev/null || break
    sleep 1
  done
  if dev_running_pid >/dev/null; then
    if [ -n "$pgid" ]; then
      kill -KILL -- "-$pgid" 2>/dev/null || true
    else
      kill -KILL "$pid" 2>/dev/null || true
    fi
  fi
  rm -f "$DEV_PID_FILE"
  echo "==> Stopped."
}

dev_status() {
  local pid url
  if pid="$(dev_running_pid)"; then
    url="$(dev_web_url || true)"
    echo "Running (pid $pid) — $url  (server port $(dev_runner_field serverPort))"
    if [ -n "$url" ] && command -v curl >/dev/null; then
      curl -sf -o /dev/null --max-time 2 "$url" && echo "Web UI reachable." ||
        echo "Warning: web UI not answering yet."
    fi
  else
    echo "Not running."
  fi
}

dev_logs() {
  [ -f "$DEV_LOG_FILE" ] || { echo "error: no log at $DEV_LOG_FILE" >&2; exit 1; }
  tail -n 50 -f "$DEV_LOG_FILE"
}

dev_pair() {
  local server_port url
  dev_running_pid >/dev/null || { echo "error: not running — start with: apna dev up" >&2; exit 1; }
  server_port="$(dev_runner_field serverPort || true)"
  url="$(dev_web_url || true)"
  if [ -z "$server_port" ] || [ -z "$url" ]; then
    echo "error: could not read ports from $DEV_LOG_FILE" >&2
    exit 1
  fi
  (cd "$REPO_ROOT" && T3CODE_PORT="$server_port" node apps/server/src/bin.ts auth pairing create \
    --base-dir "$DEV_STATE_DIR" \
    --dev-url "$url" \
    --base-url "$url" \
    --ttl 15m \
    --label apna-cli)
}

usage() {
  sed -n '2,19p' "$SCRIPT_PATH" | sed 's/^# \{0,1\}//'
}

case "${1:-help}" in
  dev)
    case "${2:-}" in
      up) dev_up ;;
      down) dev_down ;;
      restart) dev_down; dev_up ;;
      status) dev_status ;;
      logs) dev_logs ;;
      pair) dev_pair ;;
      *) usage; exit 1 ;;
    esac
    ;;
  app)
    case "${2:-}" in
      update) build; install_app; launch ;;
      run) launch ;;
      quit) quit_installed ;;
      build) build ;;
      install) install_app; launch ;;
      *) usage; exit 1 ;;
    esac
    ;;
  help|--help|-h) usage ;;
  *) usage; exit 1 ;;
esac
